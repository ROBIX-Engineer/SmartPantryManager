
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#4A795A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add an ingredient"
            android:textColor="#20372A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Keep track of what you have available."
            android:textColor="#68766C"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredient name"
            android:textColor="#20372A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:hint="e.g. Tomatoes"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textColor="#20372A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:hint="e.g. 5"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unit of measurement"
            android:textColor="#20372A"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry date (optional)"
            android:textColor="#20372A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:background="#FFFFFF"
            android:hint="YYYY-MM-DD"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:clickable="true" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#245C43" />

        <Button
            android:id="@+id/btnCancelIngredient"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#245C43"
            android:backgroundTint="#E2F0E5" />

    </LinearLayout>

</ScrollView>
